# Supabase project settings (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: Google OAuth "Web application" client ID. When set, the landing page renders
# Google's official Sign in with Google button (Google Identity Services) and signs in with
# signInWithIdToken. When empty, the app uses the Supabase OAuth redirect flow instead.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
